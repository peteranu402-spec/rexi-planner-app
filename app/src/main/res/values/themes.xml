<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/ic_bg</item>
    </style>
    <style name="AlarmTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hero</item>
        <item name="android:statusBarColor">@color/hero</item>
        <item name="android:navigationBarColor">@color/hero</item>
        <item name="android:colorAccent">@color/ic_bg</item>
    </style>
</resources>
